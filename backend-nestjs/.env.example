# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
FRONTEND_URL="http://localhost:5173"
MAIL_HOST="127.0.0.1"
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@lifely.local"
MAIL_FROM_NAME="Lifely"
LIFELY_APP_MODE="production"
LIFELY_DEMO_EMAIL_LIMIT=3
LIFELY_QUEUE_ENABLED="true"
LIFELY_QUEUE_WORKER_ENABLED="false"
LIFELY_SCHEDULER_ENABLED="false"
