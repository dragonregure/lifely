// use prisma-next

model Tenant {
  id        Uuid     @id @default(uuid())
  name      String
  users     User[]
  contacts  Contact[]
  listings  Listing[]
  documents Document[]
  roles     Role[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("tenants")
}

model User {
  id                 Uuid                  @id @default(uuid())
  tenantId           Uuid
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  listingAssignments ListingUser[]
  role               String                @default("Simple Agent")
  name               String
  email              String                @unique
  password           String
  emailVerifiedAt    TimestamptzString?
  tokens             PersonalAccessToken[]
  roleAssignments    ModelHasRole[]
  permissionGrants   ModelHasPermission[]
  createdAt          TimestamptzString     @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([tenantId])
  @@map("users")
}

model Contact {
  id              Uuid              @id @default(uuid())
  tenantId        Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId         Uuid?
  owner           User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  listingAssignments ListingContact[]
  firstName       String
  lastName        String
  email           String
  phone           String?
  status          Boolean           @default(true)
  budget          Decimal?
  source          SmallInt?
  lastContactedAt TimestamptzString?
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([tenantId, ownerId])
  @@map("contacts")
}

model Listing {
  id           Uuid              @id @default(uuid())
  tenantId     Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  address      String
  price        Decimal
  status       SmallInt          @default(1)
  bedrooms     SmallInt          @default(0)
  bathrooms    SmallInt          @default(0)
  propertyType SmallInt          @default(1)
  contacts     ListingContact[]
  users        ListingUser[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([tenantId, status])
  @@index([tenantId, propertyType])
  @@map("listings")
}

model ListingContact {
  listingId Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactId Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listingId, contactId])
  @@index([contactId])
  @@map("listing_contacts")
}

model ListingUser {
  listingId      Uuid
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId         Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimaryOwner Boolean?

  @@id([listingId, userId])
  @@unique([listingId, isPrimaryOwner])
  @@index([userId])
  @@map("listing_users")
}

model Document {
  id        Uuid              @id @default(uuid())
  tenantId  Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model     String
  modelId   Uuid
  type      String
  subtype   String?
  fileName  String?
  order     Int               @default(0)
  url       String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([tenantId, model, modelId])
  @@index([tenantId, model, modelId, type, order])
  @@map("documents")
}

model PersonalAccessToken {
  id            Int                @id @default(autoincrement())
  tokenableId   Uuid
  tokenable     User               @relation(fields: [tokenableId], references: [id], onDelete: Cascade)
  name          String
  token         String             @unique
  ability       String
  lastUsedAt    TimestamptzString?
  expiresAt     TimestamptzString?
  createdAt     TimestamptzString  @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([tokenableId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model Permission {
  id                Int                  @id @default(autoincrement())
  name              String
  guardName         String               @default("web")
  roleGrants        RoleHasPermission[]
  userGrants        ModelHasPermission[]
  createdAt         TimestamptzString    @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([name, guardName])
  @@map("permissions")
}

model Role {
  id                Int                  @id @default(autoincrement())
  tenantId          Uuid?
  tenant            Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  guardName         String               @default("web")
  permissionGrants  RoleHasPermission[]
  userAssignments   ModelHasRole[]
  createdAt         TimestamptzString    @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([tenantId, name])
  @@unique([tenantId, name, guardName])
  @@map("roles")
}

model RoleHasPermission {
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

model ModelHasRole {
  roleId    Int
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  modelType String
  modelId   Uuid
  user      User   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([roleId, modelId, modelType])
  @@index([modelId, modelType])
  @@map("model_has_roles")
}

model ModelHasPermission {
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  modelType    String
  modelId      Uuid
  user         User       @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([permissionId, modelId, modelType])
  @@index([modelId, modelType])
  @@map("model_has_permissions")
}
